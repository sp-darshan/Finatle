// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  uid       String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed with salt
  name      String?
  phone     String?  // User contact phone number
  age       Int?     // User age
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts  Account[]
  transactions Transaction[]
  moneyLent MoneyLent[]
  moneyBorrowed MoneyBorrowed[]
  budgets   Budget[]

  @@map("users")
}

model Account {
  aid           String        @id @default(uuid())
  uid           String
  name          String        @default("Cash")
  type          AccountType   @default(CASH)
  balance       Decimal       @default(0) @db.Decimal(14, 2)
  initialBalance Decimal      @default(0) @db.Decimal(14, 2)
  accountNumber String?
  institution   String?
  color         String?       @default("#10b981")
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [uid], references: [uid], onDelete: Cascade)
  transactions  Transaction[]
  moneyLent     MoneyLent[]
  moneyBorrowed MoneyBorrowed[]

  @@index([uid])
  @@map("accounts")
}

model Transaction {
  tid         String            @id @default(uuid())
  uid         String
  accountId   String?
  type        TransactionType
  amount      Decimal           @db.Decimal(14, 2)
  description String?
  category    String?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [uid], references: [uid], onDelete: Cascade)
  account     Account?          @relation(fields: [accountId], references: [aid], onDelete: SetNull)
  items       TransactionItem[]

  @@index([uid, occurredAt])
  @@index([accountId])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  name          String
  price         Decimal     @db.Decimal(14, 2)
  quantity      Int         @default(1)
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [tid], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_items")
}

model MoneyLent {
  lid                   String       @id @default(uuid())
  uid                   String
  accountId             String?
  personName            String
  amount                Decimal      @db.Decimal(14, 2)
  paidAmount            Decimal      @default(0) @db.Decimal(14, 2)
  description           String?
  lentAt                DateTime     @default(now())
  dueAt                 DateTime?
  borrowerEmail         String?
  reminderFrequencyDays Int          @default(1)
  lastReminderSentAt    DateTime?
  claimedPaid           Boolean      @default(false)
  claimedPaidAt         DateTime?
  snoozeReminders       Boolean      @default(false)
  claimToken            String?      @unique
  status                LoanStatus   @default(PENDING)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [uid], references: [uid], onDelete: Cascade)
  account               Account?     @relation(fields: [accountId], references: [aid], onDelete: SetNull)

  @@index([uid, status])
  @@index([accountId])
  @@map("money_lent")
}

model MoneyBorrowed {
  bid         String       @id @default(uuid())
  uid         String
  accountId   String?
  personName  String
  amount      Decimal      @db.Decimal(14, 2)
  paidAmount  Decimal      @default(0) @db.Decimal(14, 2)
  description String?
  borrowedAt  DateTime     @default(now())
  dueAt       DateTime?
  status      LoanStatus   @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [uid], references: [uid], onDelete: Cascade)
  account     Account?     @relation(fields: [accountId], references: [aid], onDelete: SetNull)

  @@index([uid, status])
  @@index([accountId])
  @@map("money_borrowed")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoanStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

model Budget {
  id        String   @id @default(uuid())
  uid       String
  category  String
  limit     Decimal  @db.Decimal(14, 2)
  period    String   @default("monthly")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@unique([uid, category])
  @@index([uid])
  @@map("budgets")
}

enum AccountType {
  CASH
  BANK
  WALLET
  SAVINGS
  OTHER
}




