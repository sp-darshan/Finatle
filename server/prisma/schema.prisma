// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  uid       String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed with salt
  name      String?
  phone     String?  // User contact phone number
  age       Int?     // User age
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account?
  transactions Transaction[]
  moneyLent MoneyLent[]
  moneyBorrowed MoneyBorrowed[]

  @@map("users")
}

model Account {
  aid       String   @id @default(uuid())
  uid       String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@map("accounts")
}

model Transaction {
  tid         String          @id @default(uuid())
  uid         String
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  description String?
  category    String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@index([uid, occurredAt])
  @@map("transactions")
}

model MoneyLent {
  lid                   String       @id @default(uuid())
  uid                   String
  personName            String
  amount                Decimal      @db.Decimal(14, 2)
  paidAmount            Decimal      @default(0) @db.Decimal(14, 2)
  description           String?
  lentAt                DateTime     @default(now())
  dueAt                 DateTime?
  borrowerEmail         String?
  reminderFrequencyDays Int          @default(1)
  lastReminderSentAt    DateTime?
  claimedPaid           Boolean      @default(false)
  claimedPaidAt         DateTime?
  snoozeReminders       Boolean      @default(false)
  claimToken            String?      @unique
  status                LoanStatus   @default(PENDING)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@index([uid, status])
  @@map("money_lent")
}

model MoneyBorrowed {
  bid         String       @id @default(uuid())
  uid         String
  personName  String
  amount      Decimal      @db.Decimal(14, 2)
  paidAmount  Decimal      @default(0) @db.Decimal(14, 2)
  description String?
  borrowedAt  DateTime     @default(now())
  dueAt       DateTime?
  status      LoanStatus   @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [uid], references: [uid], onDelete: Cascade)

  @@index([uid, status])
  @@map("money_borrowed")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoanStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}


