PORT=5000

# Deployed frontend origin (for example: https://your-app.vercel.app)
CLIENT_URL="http://localhost:3000"

# Connect to Supabase Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.feilifelevodyxcxmxvu:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Supabase Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.feilifelevodyxcxmxvu:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# JWT Auth Secret
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Google Gemini API Key for AI Bill & Receipt Vision Scanner
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Public Server URL (used in email one-click payment claim buttons)
# Local: http://localhost:5000 | Production: https://your-finatle-api.onrender.com
APP_URL="http://localhost:5000"

# Email Settings (HTTPS REST API recommended for cloud hosts like Render where SMTP ports are blocked)
# Option A: Brevo HTTPS REST API (Free 300 emails/day = 9,000/mo to any recipient, no custom domain needed)
# Get a free key at: https://brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="notify.projects@gmail.com"

# Option B: Standard SMTP (Gmail App Password - works on localhost or VPS)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Finatle Reminders <your-email@gmail.com>"

